[Unit]
Description=RoboParty Bluetooth WiFi Provisioning (legacy, disabled by default)
# PRD 5.8: the legacy RFCOMM provisioning entry must not be exposed by default.
# Create /etc/rp-server/enable-btwifi only for an explicitly authorized legacy
# provisioning window; the packaged postinst no longer enables this unit.
ConditionPathExists=/etc/rp-server/enable-btwifi
After=bluetooth.target network.target
Wants=bluetooth.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
Group=root
Environment=PYTHONPATH=/opt/roboparty/lib/python3/dist-packages
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m rp_server.btwifi
Restart=always
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
