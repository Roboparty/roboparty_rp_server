#!/usr/bin/make -f

INSTALL_PREFIX ?= /opt/roboparty
%:
	dh $@

execute_before_dh_auto_configure:
	python3 scripts/check_python_depends.py

override_dh_install:
	dh_install
	install -D -m 644 config/server.yaml \
		debian/roboparty-rp-server$(INSTALL_PREFIX)/share/roboparty-rp-server/config/server.yaml
	install -D -m 755 scripts/stop_robot.sh \
		debian/roboparty-rp-server$(INSTALL_PREFIX)/share/roboparty-rp-server/scripts/stop_robot.sh
	install -D -m 755 scripts/segment_tool.py \
		debian/roboparty-rp-server$(INSTALL_PREFIX)/share/roboparty-rp-server/scripts/segment_tool.py
	chmod 0755 debian/roboparty-rp-server/usr/sbin/rp-server-config
	chmod 0755 debian/roboparty-rp-server/usr/sbin/rp-server-pair
	chmod 0755 debian/roboparty-rp-server/usr/sbin/rp-server-gen-tls
	chmod 0755 debian/roboparty-rp-server$(INSTALL_PREFIX)/share/roboparty-rp-server/scripts/stop_robot.sh
	chmod 0755 debian/roboparty-rp-server$(INSTALL_PREFIX)/share/roboparty-rp-server/scripts/segment_tool.py
	# Python package
	mkdir -p debian/roboparty-rp-server$(INSTALL_PREFIX)/lib/python3/dist-packages/rp_server
	cp -r src/rp_server/*.py \
		src/rp_server/transport src/rp_server/protocol src/rp_server/drivers src/rp_server/monitors src/rp_server/auth \
		debian/roboparty-rp-server$(INSTALL_PREFIX)/lib/python3/dist-packages/rp_server/
	find debian/roboparty-rp-server$(INSTALL_PREFIX)/lib/python3/dist-packages/rp_server \
		-name '__pycache__' -type d -exec rm -rf {} + 2>/dev/null || true
